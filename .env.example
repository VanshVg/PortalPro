# ==========================================
# PortalPro — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values

# Database (Supabase PostgreSQL)
# Use the Transaction Pooler URL (port 6543) for DATABASE_URL — direct port 5432 is often blocked by ISPs
# Get both URLs from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth.js v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# App URLs
NEXT_PUBLIC_AGENCY_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portalpro-files"
R2_PUBLIC_URL=""

# Nodemailer (SMTP — Gmail App Password recommended)
# Gmail setup: enable 2FA → Google Account → Security → App Passwords → generate 16-char password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="PortalPro <your-gmail@gmail.com>"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
