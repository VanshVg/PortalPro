# ==========================================
# PortalPro — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/portalpro?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/portalpro?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App URLs
NEXT_PUBLIC_AGENCY_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portalpro-files"
R2_PUBLIC_URL=""

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@portalpro.app"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Environment
NODE_ENV="development"
LOG_LEVEL="debug"
