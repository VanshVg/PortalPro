{
  "name": "@portalpro/email",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@react-email/components": "0.0.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "nodemailer": "6.9.16"
  },
  "devDependencies": {
    "@portalpro/eslint-config": "workspace:*",
    "@portalpro/tsconfig": "workspace:*",
    "@types/nodemailer": "6.4.17",
    "@types/react": "18.3.18",
    "eslint": "8.57.1",
    "typescript": "5.7.3"
  }
}
