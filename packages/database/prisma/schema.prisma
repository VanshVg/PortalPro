generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== TENANT & AUTH =====

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logo           String?
  primaryColor   String   @default("#1B4D6E")
  secondaryColor String   @default("#2E86AB")
  customDomain   String?  @unique
  plan           Plan     @default(FREE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members  TenantMember[]
  clients  ClientPortal[]
  projects Project[]
  invoices Invoice[]
  webhooks Webhook[]
  audits   AuditLog[]
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  emailVerified DateTime?
  locale        String    @default("en")
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantMembers TenantMember[]
  clientAccess  ClientPortalAccess[]
  messages      Message[]
  comments      Comment[]
  timeEntries   TimeEntry[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TenantMember {
  id       String     @id @default(cuid())
  role     MemberRole @default(EDITOR)
  tenantId String
  userId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// ===== CLIENT PORTAL =====

model ClientPortal {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  logo         String?
  primaryColor String?
  customDomain String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  access   ClientPortalAccess[]
  projects Project[]

  @@unique([tenantId, slug])
}

model ClientPortalAccess {
  id             String      @id @default(cuid())
  clientPortalId String
  userId         String
  invitedAt      DateTime    @default(now())
  acceptedAt     DateTime?
  role           ClientRole  @default(VIEWER)

  clientPortal ClientPortal @relation(fields: [clientPortalId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientPortalId, userId])
}

enum ClientRole {
  ADMIN
  VIEWER
}

// ===== PROJECT & TASK =====

model Project {
  id             String        @id @default(cuid())
  tenantId       String
  clientPortalId String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientPortal ClientPortal @relation(fields: [clientPortalId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
  tasks        Task[]
  files        File[]
  folders      Folder[]
  deliverables Deliverable[]
  messages     Message[]
  timeEntries  TimeEntry[]
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  isCompleted Boolean   @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  number      Int        @default(0)
  sortOrder   Int        @default(0)
  blockedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  blockedBy Task?      @relation("TaskBlocking", fields: [blockedById], references: [id])
  blocking  Task[]     @relation("TaskBlocking")
  comments  Comment[]
  timeEntries TimeEntry[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ===== FILE & FOLDER =====

model File {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  key        String   // S3/R2 object key
  size       Int
  mimeType   String
  version    Int      @default(1)
  parentId   String?  // for version history
  uploadedBy String
  folderId   String?
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   File?   @relation("FileVersions", fields: [parentId], references: [id])
  versions File[]  @relation("FileVersions")
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model Folder {
  id        String  @id @default(cuid())
  projectId String
  name      String
  parentId  String?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")
  files    File[]
}

// ===== MESSAGING =====

model Message {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  content   String
  threadId  String?  // parent message for threading
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id])
  parent      Message?            @relation("MessageThread", fields: [threadId], references: [id])
  replies     Message[]           @relation("MessageThread")
  attachments MessageAttachment[]
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  fileKey   String // S3/R2 key
  fileName  String
  mimeType  String
  size      Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// ===== DELIVERABLE & APPROVAL =====

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      DeliverableStatus @default(DRAFT)
  fileIds     String[]
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  feedback    String?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions DeliverableRevision[]
}

model DeliverableRevision {
  id             String   @id @default(cuid())
  deliverableId  String
  fromStatus     String
  toStatus       String
  actorId        String?
  feedback       String?
  createdAt      DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  FINAL
}

// ===== BILLING =====

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  projectId   String?
  number      String
  clientEmail String?
  amount      Decimal       @default(0)
  currency    String        @default("USD")
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  stripeLink  String?
  fileKey     String?
  notes       String?
  lineItems   Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ===== TIME TRACKING =====

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  userId      String
  description String?
  minutes     Int
  date        DateTime
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id])
}

// ===== TASK COMMENTS =====

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

// ===== WEBHOOKS =====

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  events    String[] // e.g., ["project.updated", "task.completed"]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ===== AUDIT LOG =====

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String   // e.g., "project.created", "file.uploaded"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}
