{
  "name": "@portalpro/database",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "6.2.1"
  },
  "devDependencies": {
    "@portalpro/eslint-config": "workspace:*",
    "@portalpro/tsconfig": "workspace:*",
    "eslint": "8.57.1",
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
